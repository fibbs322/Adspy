# Скопируй этот файл в .env и заполни своими значениями.
# НИКОГДА не коммить .env в git и не публикуй его.

# Токен доступа к Facebook/Meta Ad Library API.
# Как получить — см. DEPLOY_GUIDE.md, раздел "Facebook Ad Library API".
FB_ACCESS_TOKEN=paste_your_facebook_access_token_here

# Секрет для подписи JWT-токенов пользователей. Сгенерируй случайную строку, например:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Порт, на котором запускается сервер (хостинг обычно задаёт его сам через переменную окружения PORT)
PORT=3000

# Разрешённый источник для CORS (адрес фронтенда). "*" — для разработки, в проде укажи свой домен.
CORS_ORIGIN=*
