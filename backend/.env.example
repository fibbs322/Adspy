# Скопируй этот файл в .env и заполни своими значениями.
# НИКОГДА не коммить .env в git и не публикуй его.

# Токен доступа к Facebook/Meta Ad Library API.
# Как получить — см. DEPLOY_GUIDE.md, раздел "Facebook Ad Library API".
FB_ACCESS_TOKEN=paste_your_facebook_access_token_here

# Секрет для подписи JWT-токенов пользователей. Сгенерируй случайную строку, например:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Порт, на котором запускается сервер (хостинг обычно задаёт его сам через переменную окружения PORT)
PORT=3000

# Разрешённый источник для CORS (адрес фронтенда). "*" — для разработки, в проде укажи свой домен.
CORS_ORIGIN=*

# Client ID для входа через Google ("Войти через Google"). Необязательно — без него
# кнопка Google просто не показывается на сайте.
# Как получить — см. DEPLOY_GUIDE.md, раздел "Вход через Google".
GOOGLE_CLIENT_ID=

# Данные для отправки писем с кодом подтверждения email (сервис Brevo).
# Необязательно — без BREVO_API_KEY регистрация просто пропускает подтверждение почты.
# Как получить — см. DEPLOY_GUIDE.md, раздел "Подтверждение email при регистрации".
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=AdSpy

# Email, под которым нужно автоматически получить права администратора при входе/регистрации.
# У админа всегда есть доступ к поиску объявлений; у обычных пользователей по умолчанию
# доступа нет — его включает админ вручную (кнопка «⚙️ Админка» на сайте).
# Как это работает — см. DEPLOY_GUIDE.md, раздел "Администратор и платный доступ".
ADMIN_EMAIL=
